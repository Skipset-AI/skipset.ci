[Unit]
Description=Skipset CI controller
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/skipset-ci/app
EnvironmentFile=/etc/skipset-ci/env
ExecStart=/opt/skipset-ci/venv/bin/uvicorn controller.app:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target